# Environment variables used by the Notes Backend
# Copy this file to .env and set the values for production.

# JWT secret must be at least 32 chars for HS256 key strength
SECURITY_JWT_SECRET=change_me_to_a_long_random_secret_value_at_least_32_chars

# Token expiration in milliseconds (default 86400000 = 1 day)
SECURITY_JWT_EXPIRATION_MS=86400000
